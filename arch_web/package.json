{
  "name": "cidco-architect-portal",
  "version": "1.0.0",
  "private": true,
  "description": "The architect's API dashboard. Runs on its own port, against the same database as the CIDCO portal.",
  "scripts": {
    "dev": "npm run db:generate && next dev -p 3001",
    "build": "npm run db:generate && next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "next start -p 3001",
    "lint": "next lint",
    "db:generate": "node scripts/sync-schema.mjs && prisma generate",
    "prebuild": "node scripts/check-shared-lib.mjs",
    "postinstall": "node scripts/sync-schema.mjs && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "jose": "^5.9.6",
    "next": "15.1.6",
    "papaparse": "^5.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ssh2": "^1.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/ssh2": "^1.15.6",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
