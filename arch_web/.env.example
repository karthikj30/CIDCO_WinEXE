# ---------------------------------------------------------------------------
# The architect API portal
# ---------------------------------------------------------------------------
# Same database as the CIDCO portal — this app reads and writes the same
# tables, so the two must point at one server.
DATABASE_URL="postgresql://cidco_sftp:CHANGE_ME@localhost:5432/cidco_sftp?schema=public"

# The key this server signs browser sessions with. One value for the whole
# installation — not per user, and untouched by anyone logging in.
#
# It MUST be the same string as CIDCO_WEB's. Cookies ignore the port, so the
# cookie set by the CIDCO portal is sent here too; with a different secret this
# app rejects it and an architect who just signed in lands on a login form.
#
# Generate once:  openssl rand -base64 48
# Changing it later signs everyone out. Nothing else breaks.
JWT_SECRET="CHANGE_ME_TO_THE_SAME_VALUE_AS_CIDCO_WEB"

# Where this app listens. pm2 reads ARCH_WEB_PORT from CIDCO_WEB/.env.
PORT=3001

# Serving over plain http on a bare IP? Cookies marked Secure are dropped
# silently by the browser. Same setting as CIDCO_WEB.
COOKIE_SECURE=false
