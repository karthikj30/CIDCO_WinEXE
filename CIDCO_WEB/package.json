    "next": "15.1.6",
    "papaparse": "^5.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ssh2": "^1.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/ssh2": "^1.15.6",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.1",
