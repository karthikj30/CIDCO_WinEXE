DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cidco_aqi?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
UPLOAD_DIR="./uploads"
NEXT_PUBLIC_APP_NAME="CIDCO AQI Compliance Portal"

# --- SFTP channel (npm run sftp) -------------------------------------------
SFTP_PORT=2222
SFTP_HOST=0.0.0.0
# Uploaded workbooks and the generated SSH host key live here.
SFTP_STORAGE_DIR="./storage/sftp"
# Hostname shown to architects in the dashboards; defaults to the request host.
# SFTP_PUBLIC_HOST="cidco.example.gov.in"

# The one portal login handed to every architect. They sign in with this, then
# connect with their company's SFTP user id and password.
# ARCHITECT_PORTAL_EMAIL="cidco@gmail.com"
# ARCHITECT_PORTAL_PASSWORD="123456"

# --- Windows agent + the data tables ---------------------------------------
# The one SFTP login every architect's Windows agent signs in with. The company
# it is sending for travels in the upload path (/<companyId>/<path>/<file>.csv)
# and is validated against the master record on every transfer.
# SFTP_SHARED_USER="cidco@example.com"
# SFTP_SHARED_PASSWORD="123456"
# Accepted CSVs are filed here as <companyId>/<month>/<date>/<timestamp>/<file>.csv
# after poll1. The agent never creates this tree — only the poll worker does.
CIDCO_DATA_DIR="./storage/cidco-data"
CIDCO_INBOX_DIR="./storage/inbox"
CIDCO_ARCHIVE_DIR="./storage/archive"
POLL_INTERVAL_MS=15000
