      "value": "cidco@gmail.com"
    }
  ],
  "item": [
    {
      "name": "Admin (CIDCO officer)",
      "item": [
        {
          "name": "Officer login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged in', () => pm.response.to.have.status(200));",
                  "const u = pm.response.json().data.user;",
                  "pm.expect(u.role).to.not.eql('ARCHITECT');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Signs in the CIDCO officer. Sets an httpOnly session cookie that the admin requests below reuse."
          }
        },
        {
          "name": "Issue handshake credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('issued', () => pm.response.to.have.status(201));",
                  "const c = pm.response.json().data.credential;",
                  "const h = pm.response.json().data.handshake;",
                  "pm.collectionVariables.set('clientId', c.clientId);",
                  "pm.collectionVariables.set('clientSecret', c.clientSecret);",
                  "pm.collectionVariables.set('handshakeId', h.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"architectEmail\": \"{{architectEmail}}\",\n  \"expiresInDays\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/handshakes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "handshakes"
              ]
            },
            "description": "Issues the credential JSON to hand to the architect. clientSecret is returned once."
          }
        },
        {
          "name": "List validation requests (approval queue)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('listed', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().data.requests;",
                  "const mine = rows.find(r => r.handshake.clientId === pm.collectionVariables.get('clientId'));",
                  "if (mine) pm.collectionVariables.set('validationRequestId', mine.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/validation-requests?status=PENDING",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "validation-requests?status=PENDING"
              ]
            },
            "description": "Every architect who has presented their CIDCO credentials and is waiting to be approved. Shows the architect, the IP they called from and their device."
          }
        },
        {
          "name": "Approve validation request (issues + delivers tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('approved', () => pm.response.to.have.status(200));",
                  "console.log(pm.response.json().data.message);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/validation-requests/{{validationRequestId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "validation-requests",
                "{{validationRequestId}}",
                "approve"
              ]
            },
            "description": "The officer approves: CIDCO whitelists the IP/device, establishes the channel, generates the access + refresh pair and delivers both \u2014 plus every endpoint URL \u2014 to the architect's dashboard as a message."
          }
        },
        {
          "name": "Reject validation request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewNote\": \"IP does not match the registered site\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/validation-requests/{{validationRequestId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "validation-requests",
                "{{validationRequestId}}",
                "reject"
              ]
            },
            "description": "Refuse the attempt. The architect sees the note on their dashboard."
          }
        },
        {
          "name": "List handshakes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/handshakes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "handshakes"
              ]
            }
          }
        },
        {
          "name": "Generate tokens (mode: both | access | refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token issued', () => pm.response.to.have.status(201));",
                  "const t = pm.response.json().data.token;",
                  "if (t.accessToken) { pm.collectionVariables.set('accessToken', t.accessToken); pm.collectionVariables.set('token', t.accessToken); }",
                  "if (t.refreshToken) pm.collectionVariables.set('refreshToken', t.refreshToken);",
                  "console.log('mode:', pm.response.json().data.mode, '| access:', !!t.accessToken, '| refresh:', !!t.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"clientSecret\": \"{{clientSecret}}\",\n  \"mode\": \"both\",\n  \"expiresInDays\": 7,\n  \"refreshExpiresInDays\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/handshakes/{{handshakeId}}/tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "handshakes",
                "{{handshakeId}}",
                "tokens"
              ]
            },
            "description": "CIDCO chooses which token(s) to generate via `mode`:\n- **both** (default) \u2014 new access + refresh pair; revokes any earlier pair. Give the architect both.\n- **access** \u2014 new access token only; the current refresh token keeps working.\n- **refresh** \u2014 new refresh token only; the current access token keeps working.\n\nFields not generated come back as null. 409 if the handshake has no live pair yet (use mode 'both' first) or is not ESTABLISHED."
          }
        },
        {
          "name": "List token requests",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = pm.response.json().data.tokenRequests;",
                  "const pending = rows.find(r => r.status === 'PENDING');",
                  "if (pending) pm.collectionVariables.set('tokenRequestId', pending.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/token-requests?status=PENDING",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "token-requests"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          }
        },
        {
          "name": "Approve token request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('approved', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('token', pm.response.json().data.token.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expiresInDays\": 7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/token-requests/{{tokenRequestId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "token-requests",
                "{{tokenRequestId}}",
                "approve"
              ]
            }
          }
        },
        {
          "name": "Communication logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/comm-logs?handshakeId={{handshakeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "comm-logs"
              ],
              "query": [
                {
                  "key": "handshakeId",
                  "value": "{{handshakeId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Revoke handshake",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/handshakes/{{handshakeId}}/revoke",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "handshakes",
                "{{handshakeId}}",
                "revoke"
              ]
            }
          }
        },
        {
          "name": "Set token policy (expiry days)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessTokenTtlDays\": 7,\n  \"refreshTokenTtlDays\": 30,\n  \"enforceWhitelist\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/handshakes/{{handshakeId}}/policy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "handshakes",
                "{{handshakeId}}",
                "policy"
              ]
            },
            "description": "CIDCO sets the access/refresh validity windows and whether the IP whitelist is enforced. Applies to every token issued afterwards."
          }
        },
        {
          "name": "Set expiry date on the live token pair",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessExpiresAt\": \"2026-09-01T00:00:00Z\",\n  \"refreshExpiresAt\": \"2026-10-01T00:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/handshakes/{{handshakeId}}/token-expiry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "handshakes",
                "{{handshakeId}}",
                "token-expiry"
              ]
            },
            "description": "Overrides the expiry dates on the pair the architect already holds."
          }
        },
        {
          "name": "Reset IP/device whitelist",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/handshakes/{{handshakeId}}/whitelist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "handshakes",
                "{{handshakeId}}",
                "whitelist"
              ]
            },
            "description": "Clears the registered IP/device so the architect can register a new machine on the next validate."
          }
        }
      ]
    },
    {
      "name": "Architect",
      "item": [
        {
          "name": "Validate \u2014 present CIDCO credentials (expect 202)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('queued for CIDCO', () => pm.response.to.have.status(202));",
                  "const d = pm.response.json().data;",
                  "pm.expect(d.status).to.eql('AWAITING_APPROVAL');",
                  "pm.collectionVariables.set('validationRequestId', d.requestId);",
                  "console.log(d.message);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"clientSecret\": \"{{clientSecret}}\",\n  \"ipAddress\": \"{{$randomIP}}\",\n  \"deviceInfo\": \"RaspberryPi-4 | station STN-KHR-07\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/architect/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "architect",
                "validate"
              ]
            },
            "description": "CASE 1, step 1. Send the user id and password CIDCO emailed you, plus the IP/device to whitelist. No tokens are issued here \u2014 the request is queued for a CIDCO officer and answers 202. NOTE: replace {{$randomIP}} with your real station IP; CIDCO whitelists whatever you send and later calls must match it."
          }
        },
        {
          "name": "Validate \u2014 wrong password (expect 504)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected with 504', () => pm.response.to.have.status(504));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"clientSecret\": \"hs_sec_wrong_secret\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/architect/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "architect",
                "validate"
              ]
            },
            "description": "Demonstrates the 504 the CIDCO protocol returns when validation fails."
          }
        },
        {
          "name": "Check my validation status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "console.log('approved:', d.approved, '| needs account setup:', d.needsAccountSetup);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"clientSecret\": \"{{clientSecret}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/architect/handshake-status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "architect",
                "handshake-status"
              ]
            },
            "description": "Works before you have a portal account. Tells you whether CIDCO approved you and whether you still have to choose a username and password."
          }
        },
        {
          "name": "Create my own username and password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('account created', () => pm.response.to.have.status(201));",
                  "console.log(pm.response.json().data.message);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"clientSecret\": \"{{clientSecret}}\",\n  \"email\": \"{{myUsername}}\",\n  \"password\": \"{{myPassword}}\",\n  \"name\": \"Ar. Rhea Nair\",\n  \"firmName\": \"Nair Design Studio\",\n  \"councilRegNo\": \"CA/2019/12345\",\n  \"phone\": \"+91 98200 11223\",\n  \"designation\": \"Principal Architect\",\n  \"address\": \"Plot 7, Sector 15, CBD Belapur\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/architect/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "architect",
                "register"
              ]
            },
            "description": "Run this once CIDCO has approved you. You pick the login you will use from now on, and the details you enter here are what CIDCO sees against your handshake."
          }
        },
        {
          "name": "Send AQI data (Bearer token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 503) {",
                  "  const d = pm.response.json().details || {};",
                  "  console.log('TOKEN EXPIRED ->', d.reason, '| action:', d.action);",
                  "  pm.test('503 carries recovery action', () => pm.expect(d.action).to.be.a('string'));",
                  "} else {",
                  "  pm.test('stored', () => pm.response.to.have.status(201));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectSiteId\": \"CIDCO-KHR-012\",\n  \"monitoringStationId\": \"STN-KHR-07\",\n  \"oem\": \"Aeroqual\",\n  \"deviceModel\": \"AQY-1\",\n  \"measuredAt\": \"{{$isoTimestamp}}\",\n  \"aqiValue\": 176,\n  \"pm25\": 78.3,\n  \"pm10\": 152.9,\n  \"no2\": 41.2,\n  \"so2\": 12.7,\n  \"co\": 0.9,\n  \"ozone\": 48.6,\n  \"temperature\": 33.4,\n  \"humidity\": 62.1,\n  \"integrationMethod\": \"Automated API (3h)\",\n  \"otherParams\": { \"windSpeed\": 3.2, \"windDir\": \"NW\", \"noise_dB\": 58 }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/architect/data",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "architect",
                "data"
              ]
            },
            "description": "Paste the access token from your dashboard message into the accessToken variable first. Each call inserts one reading, so schedule it every 3 hours. On expiry CIDCO answers 503 and returns your reading under details.returnedData."
          }
        },
        {
          "name": "Request a new access token (CASE 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('queued for CIDCO', () => pm.response.to.have.status(202));",
                  "console.log(pm.response.json().data.message);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"clientSecret\": \"{{clientSecret}}\",\n  \"refreshToken\": \"{{refreshToken}}\",\n  \"reason\": \"access token expired\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/architect/token-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "architect",
                "token-requests"
              ]
            },
            "description": "Run this when a data send answers 503 ACCESS_EXPIRED (that response also hands your unsent reading back). The request pops up on the CIDCO dashboard; an officer verifies your refresh token and delivers a new access token as a message. If the refresh token has lapsed too this answers 503 BOTH_EXPIRED \u2014 that is CASE 3, go back to Validate."
          }
        },
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-client-id",
                "value": "{{clientId}}"
              },
              {
                "key": "x-client-secret",
                "value": "{{clientSecret}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/architect/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "architect",
                "status"
              ]
            }
          }
        },
        {
          "name": "Logs (timestamped)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/architect/logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "architect",
                "logs"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "SFTP channel (CIDCO officer)",
      "description": "The SFTP channel. CIDCO registers the company by hand FIRST, then issues credentials against it, and every transfer is validated against that registration. The transfer itself is a file transfer, not HTTP \u2014 drive it with scripts/architect-sender.ts or any SFTP client. See docs/SFTP_CHANNEL.md.",
      "item": [
        {
          "name": "i. Register the company",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registered', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('companyRecordId', d.company.id);",
                  "console.log(`${d.company.companyName} (${d.company.companyId}) accepts data from ${d.company.architectServerIp} at ${d.company.filePath}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Nair Design Studio\",\n  \"companyId\": \"{{companyId}}\",\n  \"architectServerIp\": \"127.0.0.1\",\n  \"filePath\": \"/var/aqi/exports\",\n  \"architectEmail\": \"{{architectEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/sftp/companies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "sftp",
                "companies"
              ]
            },
            "description": "Step one, done by hand before any credentials exist. What you enter here is what every later transfer is validated against: the company id quoted, the address the data must arrive from, and the path it is taken from. architectEmail is stored as contact detail only \u2014 no account is created, because every architect signs in with the shared CIDCO portal login (cidco@gmail.com / 123456)."
          }
        },
        {
          "name": "List the company register",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/sftp/companies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "sftp",
                "companies"
              ]
            },
            "description": "Every registration, with the credentials issued against each one."
          }
        },
        {
          "name": "Correct a registration",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"architectServerIp\": \"203.0.113.9\",\n  \"filePath\": \"/var/aqi/exports\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/sftp/companies/{{companyRecordId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "sftp",
                "companies",
                "{{companyRecordId}}"
              ]
            },
            "description": "Fix a registration \u2014 the architect moved server, or their export path changed. Applies to the very next transfer. Send {\"active\": false} to stop their transfers entirely."
          }
        },
        {
          "name": "1. Issue SFTP credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('issued', () => pm.response.to.have.status(201));",
                  "const c = pm.response.json().data.credential;",
                  "pm.collectionVariables.set('sftpUsername', c.username);",
                  "pm.collectionVariables.set('sftpPassword', c.password);",
                  "console.log(`sftp -P ${c.port} ${c.username}@${c.designatedIp}  # then: put readings.csv ${c.filePath}/`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"expiresInDays\": 365\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/sftp/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "sftp",
                "accounts"
              ]
            },
            "description": "Step two: issue a user id and password against the registration. The response is exactly what the officer emails over \u2014 the login plus the designated IP to send to. The password is shown once."
          }
        },
        {
          "name": "List SFTP accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/sftp/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "sftp",
                "accounts"
              ]
            },
            "description": "Every SFTP user id, the company registration behind it, and what it has delivered."
          }
        },
        {
          "name": "Delivered transfers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('listed', () => pm.response.to.have.status(200));",
                  "const u = pm.response.json().data.uploads[0];",
                  "if (u) pm.collectionVariables.set('sftpUploadId', u.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/sftp/uploads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "sftp",
                "uploads"
              ]
            },
            "description": "Every transfer with its validation result \u2014 which of company id, IP and file path matched."
          }
        },
        {
          "name": "One transfer: validation + preview",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/sftp/uploads/{{sftpUploadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "sftp",
                "uploads",
                "{{sftpUploadId}}"
              ]
            },
            "description": "The full comparison \u2014 incoming beside what CIDCO registered, field by field \u2014 and the file as it arrived, row by row. A transfer that failed validation stored nothing."
          }
        },
        {
          "name": "Send by hand (portal drag-and-drop)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/architect/sftp/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "architect",
                "sftp",
                "transfer"
              ]
            },
            "description": "The portal's drag-and-drop send, validated exactly like a direct SFTP upload. In Postman set the body to form-data with: username, password, designatedIp, filePath, and file (type File \u2014 pick a .csv). Normally the architect does this by dragging a file on /architect/sftp.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "username",
                  "value": "{{sftpUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{sftpPassword}}",
                  "type": "text"
                },
                {
                  "key": "designatedIp",
                  "value": "{{sftpDesignatedIp}}",
                  "type": "text"
                },
                {
                  "key": "filePath",
                  "value": "/var/aqi/exports",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Architect: connect with the SFTP credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('connected', () => pm.response.to.have.status(200));",
                  "const a = pm.response.json().data.account;",
                  "console.log(`connected as ${a.company.companyName} (${a.company.companyId}), path ${a.company.filePath}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{sftpUsername}}\",\n  \"password\": \"{{sftpPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/architect/sftp/connect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "architect",
                "sftp",
                "connect"
              ]
            },
            "description": "Architects share one portal login, so the session cannot say which company they are. Sign in first as cidco@gmail.com / 123456, then connect with the company SFTP user id and password \u2014 that pair is the identity."
          }
        }
      ]
    }
  ]
