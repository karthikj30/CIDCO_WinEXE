{
  "info": {
    "name": "CIDCO AQI Compliance Portal",
    "description": "API collection for the CIDCO AQI reporting portal.\n\n## Getting started\n1. Set the `baseUrl` variable (default http://localhost:3000).\n2. Run **Auth > Login** (seeded architect: architect@example.com / Password123). The JWT is saved to the `token` variable automatically.\n3. Run **API Keys > Create API key**. The plaintext key is saved to the `apiKey` variable automatically.\n4. Run **Reports > Submit report (multipart)** — attach a PDF under `document` and one or more images under `boardPhotos`.\n\nFile fields are left empty on purpose: Postman cannot ship binary files inside a collection, so pick files from your own disk in the Body tab.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "apiKey", "value": "" },
    { "key": "reportId", "value": "" },
    { "key": "apiKeyId", "value": "" },
    { "key": "attachmentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] },
            "description": "Verifies the app is up and PostgreSQL is reachable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('database connected', () => pm.expect(pm.response.json().data.database).to.eql('connected'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Anita Deshmukh\",\n  \"email\": \"anita.{{$randomInt}}@studio.example\",\n  \"password\": \"SecurePass123\",\n  \"firmName\": \"Deshmukh Associates\",\n  \"councilRegNo\": \"CA/2019/12345\",\n  \"phone\": \"+91 98200 11223\",\n  \"role\": \"ARCHITECT\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.success) pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"architect@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Seeded credentials. Saves the returned JWT into the {{token}} variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('token returned', () => pm.expect(body.data.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (CIDCO officer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"officer@cidco.example\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('token', pm.response.json().data.token);"]
              }
            }
          ]
        },
        {
          "name": "Me (JWT)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Me (API key)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "API Keys",
      "item": [
        {
          "name": "Create API key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"label\": \"Postman test key\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/api-keys", "host": ["{{baseUrl}}"], "path": ["api", "api-keys"] },
            "description": "The plaintext key is returned once only and stored in {{apiKey}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const key = pm.response.json().data.apiKey;",
                  "pm.collectionVariables.set('apiKey', key.key);",
                  "pm.collectionVariables.set('apiKeyId', key.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List API keys",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/api-keys", "host": ["{{baseUrl}}"], "path": ["api", "api-keys"] }
          }
        },
        {
          "name": "Revoke API key",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/api-keys/{{apiKeyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-keys", "{{apiKeyId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Submit report (multipart, API key) — Method 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "siteName", "value": "Kharghar Sector 12 Site", "type": "text" },
                { "key": "location", "value": "Kharghar, Navi Mumbai", "type": "text" },
                { "key": "measuredAt", "value": "2026-08-01T09:30:00Z", "type": "text" },
                { "key": "aqiValue", "value": "148", "type": "text" },
                { "key": "pm25", "value": "62.4", "type": "text" },
                { "key": "pm10", "value": "120.5", "type": "text" },
                { "key": "so2", "value": "12.1", "type": "text" },
                { "key": "no2", "value": "33.8", "type": "text" },
                { "key": "co", "value": "0.8", "type": "text" },
                { "key": "ozone", "value": "41.2", "type": "text" },
                { "key": "latitude", "value": "19.0330", "type": "text" },
                { "key": "longitude", "value": "73.0630", "type": "text" },
                { "key": "projectCode", "value": "CIDCO-KHR-012", "type": "text" },
                { "key": "remarks", "value": "Morning reading, construction active", "type": "text" },
                { "key": "document", "type": "file", "src": [], "description": "Signed AQI report (PDF/DOC/DOCX/TXT)" },
                { "key": "boardPhotos", "type": "file", "src": [], "description": "Photo of the on-site AQI display board (add this key more than once for multiple photos)" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/reports", "host": ["{{baseUrl}}"], "path": ["api", "reports"] },
            "description": "The architect's own system posts the report document plus AQI board photographs to CIDCO. Select files for `document` and `boardPhotos` in the Body tab before sending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const report = pm.response.json().data.report;",
                  "pm.collectionVariables.set('reportId', report.id);",
                  "if (report.attachments.length) pm.collectionVariables.set('attachmentId', report.attachments[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit report (JSON, no attachments)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"siteName\": \"Nerul Plot 21\",\n  \"location\": \"Nerul, Navi Mumbai\",\n  \"measuredAt\": \"2026-08-06T07:00:00Z\",\n  \"aqiValue\": 75,\n  \"pm25\": 28.4,\n  \"pm10\": 61.0,\n  \"remarks\": \"Baseline reading before excavation\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/reports", "host": ["{{baseUrl}}"], "path": ["api", "reports"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('reportId', pm.response.json().data.report.id);"]
              }
            }
          ]
        },
        {
          "name": "Upload CSV — Method 2",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [], "description": "CSV file — use samples/sample-aqi-readings.csv from the repo" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/reports/csv", "host": ["{{baseUrl}}"], "path": ["api", "reports", "csv"] },
            "description": "Bulk upload. Every row is validated independently; the response lists created rows and per-row errors."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('rows processed', () => pm.expect(body.data.totalRows).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Download CSV template",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/reports/csv", "host": ["{{baseUrl}}"], "path": ["api", "reports", "csv"] }
          }
        },
        {
          "name": "List reports",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/reports?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "status", "value": "SUBMITTED", "disabled": true },
                { "key": "source", "value": "API", "disabled": true },
                { "key": "q", "value": "Kharghar", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get report",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}"]
            }
          }
        },
        {
          "name": "Download attachment",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{attachmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "{{attachmentId}}"]
            }
          }
        },
        {
          "name": "Review report (CIDCO officer)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"reviewNote\": \"Verified against the site board photograph\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}", "review"]
            },
            "description": "Run 'Login (CIDCO officer)' first — architects get 403 here."
          }
        },
        {
          "name": "Withdraw report",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}"]
            }
          }
        },
        {
          "name": "Dashboard stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "url": { "raw": "{{baseUrl}}/api/stats", "host": ["{{baseUrl}}"], "path": ["api", "stats"] }
          }
        }
      ]
    }
  ]
}
