# Local / Codespace defaults for CIDCO_WEB.
# Prisma needs DATABASE_URL or login/register fails with:
#   Environment variable not found: DATABASE_URL

# Inside a container this file is not read — pass DATABASE_URL to the
# container instead, as docker-compose.yml does.

#For Local
# DATABASE_URL="postgresql://cidco:cidco_dev@localhost:5432/cidco_aqi?schema=public"


#For Live
DATABASE_URL="postgresql://cidco_sftp:POSTGRE_72312@localhost:5432/cidco_sftp?schema=public"

# In git, so this signing key is public: anyone who can read the repository can
# mint a session for any account. Replace it, via the environment, before this
# runs anywhere reachable from outside your own machine.
JWT_SECRET="dev-jwt-secret-change-me-for-local-only-cidco-aqi"
UPLOAD_DIR="./uploads"
NEXT_PUBLIC_APP_NAME="CIDCO AQI Compliance Portal"

# --- Sessions -------------------------------------------------------------
# Whether the session cookie is marked Secure. Left unset it follows
# x-forwarded-proto, so it is on behind an https proxy and off on plain http.
#
# A browser will not store a Secure cookie on an http:// page, and says nothing
# while refusing: signing in looks like it worked and every page after it says
# "CIDCO officer sign-in required". Serving the portal over http on a bare IP
# is exactly that case. Set this to false there, or put it behind https.
# (localhost is exempt in browsers, so this never shows up locally.)
# COOKIE_SECURE=false

# Shared code that lets a CIDCO officer create their own account from the
# portal, instead of over SSH. The very first officer does not need it — there
# is nobody who could hand one out yet — but every one after does.
#
# Officers see every company's data, so leave this unset and sign-up stays
# closed after the first account. Change it if it gets out.
CIDCO_OFFICER_SIGNUP_CODE="cidco-officer-2026"

# --- SFTP channel (npm run sftp) -------------------------------------------
SFTP_PORT=2222
SFTP_HOST=0.0.0.0
SFTP_STORAGE_DIR="./storage/sftp"

# Shared architect portal login
ARCHITECT_PORTAL_EMAIL="cidco@gmail.com"
ARCHITECT_PORTAL_PASSWORD="123456"

# Shared SFTP login used by the Windows agent
SFTP_SHARED_USER="cidco@example.com"
SFTP_SHARED_PASSWORD="123456"

# Poll / data tree
CIDCO_DATA_DIR="./storage/cidco-data"

# CIDCO_DATA_DIR="/home/ubuntu/cidco/sftp1"
# Where poll1 looks for files the architect's agent has uploaded.
#
# If the agent uploads over plain SFTP into a folder on this server, set this
# to THAT folder — e.g. "/home/ubuntu/cidco/sftp1". Files arriving is not
# ingestion: poll1 only ever looks here, so pointing it somewhere else leaves
# the files sitting in the dropbox and the portal empty.
#
# The user running `npm run poll` must be able to read and delete here,
# because poll1 moves files out of it.
CIDCO_INBOX_DIR="/home/ubuntu/cidco/sftp1"
CIDCO_ARCHIVE_DIR="./storage/archive"
POLL_INTERVAL_MS=15000
