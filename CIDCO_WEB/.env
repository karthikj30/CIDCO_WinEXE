# Local / Codespace defaults for CIDCO_WEB.
# Prisma needs DATABASE_URL or login/register fails with:
#   Environment variable not found: DATABASE_URL

DATABASE_URL="postgresql://cidco:cidco_dev@localhost:5432/cidco_aqi?schema=public"
JWT_SECRET="dev-jwt-secret-change-me-for-local-only-cidco-aqi"
UPLOAD_DIR="./uploads"
NEXT_PUBLIC_APP_NAME="CIDCO AQI Compliance Portal"

# --- SFTP channel (npm run sftp) -------------------------------------------
SFTP_PORT=2222
SFTP_HOST=0.0.0.0
SFTP_STORAGE_DIR="./storage/sftp"

# Shared architect portal login
ARCHITECT_PORTAL_EMAIL="cidco@gmail.com"
ARCHITECT_PORTAL_PASSWORD="123456"

# Shared SFTP login used by the Windows agent
SFTP_SHARED_USER="cidco@example.com"
SFTP_SHARED_PASSWORD="123456"

# Poll / data tree
CIDCO_DATA_DIR="./storage/cidco-data"
CIDCO_INBOX_DIR="./storage/inbox"
CIDCO_ARCHIVE_DIR="./storage/archive"
POLL_INTERVAL_MS=15000
