# --- architect_WINexe ---
# Build output lives beside each project, not only at the root.
architect_WINexe/**/bin/
architect_WINexe/**/obj/
# Excluding the folder itself would stop git ever looking inside it, and the
# negation below would never be read. Excluding its contents leaves the one
# file we do ship — the published agent — reachable.
architect_WINexe/dist/*
!architect_WINexe/dist/CIDCO_AQI_Agent.exe
*.user
*.ppk
*.pem
*.key
id_rsa*
id_ed25519*
*.db
*.db-wal
*.db-shm
.vs/
.idea/

# --- arch_web (the architect API portal) ---
# node_modules here is a symlink to CIDCO_WEB's, so it must never be committed.
arch_web/node_modules
arch_web/node_modules/
arch_web/.next/
arch_web/out/
arch_web/build/
# Its .env holds the same database password as CIDCO_WEB's; .env.example is
# the one that ships.
arch_web/.env
arch_web/.env.local
arch_web/*.tsbuildinfo
arch_web/next-env.d.ts

# --- CIDCO_WEB ---
CIDCO_WEB/node_modules/
CIDCO_WEB/.next/
CIDCO_WEB/out/
CIDCO_WEB/build/
# Keep CIDCO_WEB/.env in git so Codespaces/clones get DATABASE_URL.
# Still ignore machine-specific overrides:
CIDCO_WEB/.env.local
CIDCO_WEB/*.tsbuildinfo
CIDCO_WEB/next-env.d.ts
CIDCO_WEB/uploads/*
!CIDCO_WEB/uploads/.gitkeep
CIDCO_WEB/storage/
CIDCO_WEB/src/generated/
.DS_Store
npm-debug.log*

architect_WINexe/.kilo/

# Local agent notes — not part of the shipped product
memory-bank/
